# Justice_system — Environment Example
# Copy to .env and fill in your values
# cp .env.example .env

# LLM Provider (pick one)
# Gemini (recommended for structured output)
GEMINI_API_KEY=
# Anthropic Claude
ANTHROPIC_API_KEY=
# OpenAI
OPENAI_API_KEY=
# OpenRouter (alternative to Anthropic/OpenAI)
OPENROUTER_API_KEY=
# Microsoft Phi (local model — no API key required, runs via transformers)
# PHI_API_KEY=

# Text-to-Speech (ElevenLabs — optional but needed for audio playback)
# Get your key at https://elevenlabs.io/app/api-keys
ELEVENLABS_API_KEY=

# Server
API_PORT=8000
API_HOST=127.0.0.1

# Legal Knowledge Base
LEGAL_DIR=docs/legal

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/justice.log
