# Justice_system — Environment Example
# Copy to .env and fill in your values
# cp .env.example .env

# LLM Provider (pick one)
# Gemini (recommended for structured output)
GEMINI_API_KEY=
# Anthropic Claude
ANTHROPIC_API_KEY=
# OpenAI / OpenRouter
OPENAI_API_KEY=

# Server
JUSTICE_HOST=127.0.0.1
JUSTICE_PORT=7860
JUSTICE_SHARE=false

# Legal Knowledge Base
LEGAL_DIR=docs/legal

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/justice.log
